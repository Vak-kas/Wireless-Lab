CS","value":2,"unit":"","kind":"decoded","source":"DCI 1_0 modulation and coding scheme","group":"dci"},{"key":"dci_rv","label":"RV","value":0,"unit":"","kind":"decoded","source":"DCI 1_0 redundancy version","group":"dci"},{"key":"dci_si_indicator","label":"SI 지시자","value":0,"unit":"","kind":"decoded","source":"DCI 1_0 system information indicator","group":"dci"},{"key":"tbs","label":"전송 블록 크기 (TBS)","value":672,"unit":"bit","kind":"derived","derivation_id":"sib1.tbs","group":"dci"}],"derivations":[{"id":"sib1.q_rxlevmin","title":"q-RxLevMin 환산","formula_tex":"Q_{rxlevmin} = 2 \\cdot \\mathrm{q\\text{-}RxLevMin}\\ \\mathrm{[dBm]}","inputs":[{"symbol":"q-RxLevMin","value":-62,"source":"SIB1.cellSelectionInfo.q-RxLevMin"}],"steps":["2 × -62 = -124 dBm"],"result":{"value":-124,"unit":"dBm"},"spec_ref":"TS 38.331 6.3.2 SIB1 / TS 38.304 5.2.3.2"},{"id":"sib1.carrier_bw_mhz","title":"RB 수를 대역폭으로","formula_tex":"BW = N_{RB} \\cdot 12 \\cdot \\Delta f","inputs":[{"symbol":"N_RB","value":25,"source":"SIB1.…carrierBandwidth"},{"symbol":"Δf","value":15,"unit":"kHz","source":"SIB1.…subcarrierSpacing"}],"steps":["25 × 12 × 15 kHz = 4.5 MHz"],"result":{"value":4.5,"unit":"MHz"},"spec_ref":"TS 38.211 4.4.4.1"},{"id":"sib1.point_a","title":"Point A 주파수","formula_tex":"f_{PointA} = f_{CRB_{SSB}} - \\mathrm{offsetToPointA} \\cdot 12 \\cdot 15\\,\\mathrm{kHz}","inputs":[{"symbol":"f_CRB_SSB","value":2182290000.0,"unit":"Hz","source":"mib: SS_REF − 120·SCS_SSB − k_SSB·15 kHz"},{"symbol":"offsetToPointA","value":2,"unit":"RB","source":"SIB1.…frequencyInfoDL.offsetToPointA"}],"steps":["2182.29 MHz − 2 × 180 kHz = 2181.93 MHz"],"result":{"value":2181.93,"unit":"MHz"},"spec_ref":"TS 38.211 4.4.4.2"},{"id":"sib1.ul_freq","title":"상향 주파수와 듀플렉스 간격","formula_tex":"F_{REF} = F_{REF\\text{-}Offs} + \\Delta F_{Global}\\,(N_{REF} - N_{REF\\text{-}Offs}),\\quad \\Delta f_{duplex} = f_{PointA}^{DL} - f_{PointA}^{UL}","inputs":[{"symbol":"N_REF","value":398386,"source":"SIB1.…frequencyInfoUL.absoluteFrequencyPointA"},{"symbol":"ΔF_Global","value":5000,"unit":"Hz","source":"TS 38.104 Table 5.4.2.1-1"},{"symbol":"F_REF-Offs","value":0,"unit":"Hz","source":"TS 38.104 Table 5.4.2.1-1"},{"symbol":"N_REF-Offs","value":0,"source":"TS 38.104 Table 5.4.2.1-1"},{"symbol":"f_PointA^DL","value":2181.93,"unit":"MHz","source":"sib1.point_a"}],"steps":["F_REF = 0 MHz + 5 kHz × (398386 − 0) = 1991.93 MHz","2181.93 − 1991.93 = 190 MHz"],"result":{"value":1991.93,"unit":"MHz"},"spec_ref":"TS 38.104 5.4.2.1"},{"id":"sib1.initial_bwp","title":"locationAndBandwidth 풀기","formula_tex":"RIV = N(L-1) + RB_{start}\\ \\ (N = 275)","inputs":[{"symbol":"locationAndBandwidth","value":6600,"source":"SIB1.…initialDownlinkBWP.genericParameters"}],"steps":["L = ⌊6600 / 275⌋ + 1 = 25","RB_start = 6600 mod 275 = 0","→ RB_start = 0, L = 25"],"result":{"value":25,"unit":"RB"},"spec_ref":"TS 38.214 5.1.2.2.2"},{"id":"sib1.prach","title":"PRACH 기회 (시간)","formula_tex":"n_{SFN} \\bmod x = y","inputs":[{"symbol":"prach-ConfigurationIndex","value":98,"source":"SIB1.…rach-ConfigCommon.rach-ConfigGeneric"},{"symbol":"spectrum","value":"paired","source":"band"}],"steps":["Table 6.3.3.2-2, index 98: format A1, x = 1, y = [0]","subframes [4], starting symbol 0","1 PRACH slot(s) per subframe, 6 occasion(s) per slot, duration 2 symbols"],"result":{"value":"SFN mod 1 = 0, subframe 4, symbol 0","unit":""},"spec_ref":"TS 38.211 Table 6.3.3.2-2"},{"id":"sib1.n_ta_offset","title":"N_TA,offset 값","formula_tex":"N_{TA,offset} = \\mathrm{n\\text{-}TimingAdvanceOffset}\\ [T_c]","inputs":[{"symbol":"n-TimingAdvanceOffset","value":"n0","source":"SIB1.servingCellConfigCommon"}],"steps":["n0 → 0 Tc"],"result":{"value":0,"unit":"Tc"},"spec_ref":"TS 38.133 7.1.2 / TS 38.211 4.3.1"},{"id":"sib1.si_window","title":"SIB19가 실린 SI 창의 시작 위치","formula_tex":"x = (n-1) \\cdot w,\\quad a = x \\bmod N,\\quad SFN \\bmod T = \\lfloor x / N \\rfloor","inputs":[{"symbol":"n","value":2,"source":"SIB1.…schedulingInfoList2-r17"},{"symbol":"w","value":20,"unit":"slots","source":"SIB1.si-SchedulingInfo.si-WindowLength"},{"symbol":"N","value":10,"source":"slots per frame"},{"symbol":"T","value":8,"unit":"frames","source":"SIB1.…si-Periodicity"}],"steps":["x = (2 − 1) × 20 = 20","a = 20 mod 10 = 0","SFN mod 8 = ⌊20 / 10⌋ = 2"],"result":{"value":0,"unit":"slot"},"spec_ref":"TS 38.331 5.2.2.3.2"},{"id":"sib1.riv","title":"RIV 풀기 (주파수 자원 위치)","formula_tex":"RIV = N(L-1) + RB_{start}\\ \\ \\left(L - 1 \\le \\lfloor N/2 \\rfloor\\right),\\quad N = N_{RB}^{CORESET0}","inputs":[{"symbol":"RIV","value":239,"source":"DCI 1_0 frequency domain resource assignment"},{"symbol":"N","value":24,"unit":"RB","source":"CORESET0 size"}],"steps":["L = ⌊239 / 24⌋ + 1 = 10","RB_start = 239 mod 24 = 23","→ RB_start = 0, L = 16"],"result":{"value":16,"unit":"RB"},"spec_ref":"TS 38.214 5.1.2.2.2"},{"id":"sib1.tdra","title":"시간 자원 할당 표 찾기","formula_tex":"(\\text{type}, K_0, S, L) = \\mathrm{Table}(m + 1,\\ \\text{dmrs-TypeA-Position})","inputs":[{"symbol":"m","value":0,"source":"DCI 1_0 time domain resource assignment"},{"symbol":"dmrs-TypeA-Position","value":2,"source":"MIB"}],"steps":["row 1: mapping type A, K0 = 0, S = 2, L = 12","symbols 2 – 13"],"result":{"value":12,"unit":"symbols"},"spec_ref":"TS 38.214 Table 5.1.2.1.1-2"},{"id":"sib1.tbs","title":"전송 블록 크기(TBS) 계산","formula_tex":"N_{RE} = \\min(156, 12 N_{symb} - N_{DMRS} - N_{oh}) \\cdot n_{PRB},\\quad N_{info} = N_{RE} \\cdot R \\cdot Q_m \\cdot \\nu","inputs":[{"symbol":"n_PRB","value":16,"unit":"RB","source":"sib1.riv"},{"symbol":"N_symb","value":12,"source":"sib1.tdra"},{"symbol":"N_DMRS","value":36,"source":"PDSCH DM-RS per PRB"},{"symbol":"Q_m","value":2,"source":"MCS 2 (TS 38.214 Table 5.1.3.1-1)"},{"symbol":"R×1024","value":193,"source":"MCS 2"}],"steps":["N'_RE = 12 × 12 − 36 − 0 = 108","N_RE = min(156, 108) × 16 = 1728","N_info = 1728 × 193/1024 × 2 × 1 = 651.375","n = max(3, ⌊log2(651.375)⌋ − 6) = 3","N'_info = max(24, 2^3 × ⌊N_info / 2^3⌋) = 648","TBS = smallest t