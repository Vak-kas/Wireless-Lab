#!/bin/bash
# "Wireless Lab.app" 은 저장소 맨 위에 놓여 있다. 터미널 창 없이 Wireless Lab 창만 띄운다.
#
# 이 앱이 Python 을 직접 띄우면 macOS 의 폴더 접근 제한(데스크탑·문서 폴더)에 막힌다("Operation not permitted").
# 그래서 실행을 macOS 의 작업 관리자(launchd)에 맡긴다: 그러면 Python 이 제 이름으로 돌아 그 제한에 걸리지 않는다.
# (처음 한 번은 macOS 가 "Python 이 … 폴더에 접근하려고 합니다"를 물을 수 있다. 허용하면 된다.)
#
# 아래 경우에는 전처럼 터미널로 nrtrail.command 를 연다.
#   - 처음 실행이라 설치할 것이 있다(진행 상황을 보여 줘야 한다)
#   - 위 방법으로 띄웠는데 몇 초 안에 실패하며 끝났다
ROOT="$(cd "$(dirname "$0")/../../.." && pwd)"
LABEL="local.wirelesslab.app"
DOMAIN="gui/$(id -u)"
TMP="${TMPDIR:-/tmp}"
LOG="$TMP/nrtrail-app.log"
PLIST="$TMP/$LABEL.plist"

terminal() { exec /usr/bin/open -a Terminal "$ROOT/nrtrail.command"; }
state() { /bin/launchctl print "$DOMAIN/$LABEL" 2>/dev/null | /usr/bin/awk -F' = ' '/^[[:space:]]*state = /{print $2; exit}'; }

# (여기서는 저장소 안의 파일을 들여다보지 않는다: 이 앱은 그 폴더를 읽는 것부터 막혀 있을 수 있다.
#  설치가 안 돼 있으면 아래에서 띄운 것이 바로 실패하고, 그러면 터미널로 넘어가 설치한다.)
[ "$(state)" = "running" ] && exit 0          # 이미 떠 있다: 하나 더 띄우지 않는다

/bin/cat > "$PLIST" <<PLIST_END
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key><array><string>$ROOT/venv/bin/python</string><string>$ROOT/tools/app.py</string></array>
  <key>WorkingDirectory</key><string>$ROOT</string>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
  <key>StandardOutPath</key><string>$LOG</string>
  <key>StandardErrorPath</key><string>$LOG</string>
  <key>ProcessType</key><string>Interactive</string>
  <key>RunAtLoad</key><true/>
</dict></plist>
PLIST_END
/bin/launchctl bootout "$DOMAIN/$LABEL" 2>/dev/null     # 지난번에 끝난 것을 치운다
: > "$LOG"
/bin/launchctl bootstrap "$DOMAIN" "$PLIST" || terminal
for _ in 1 2 3 4 5 6; do                                 # 몇 초 지켜본다: 바로 죽으면 터미널로 다시 연다
  /bin/sleep 1
  [ "$(state)" = "running" ] || { /bin/launchctl bootout "$DOMAIN/$LABEL" 2>/dev/null; terminal; }
done
exit 0
