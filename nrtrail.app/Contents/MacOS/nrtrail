#!/bin/bash
# nrtrail.app 은 저장소 맨 위에 놓여 있다. 그 폴더의 가상환경으로 실행기를 돌린다.
ROOT="$(cd "$(dirname "$0")/../../.." && pwd)"
cd "$ROOT" || exit 1
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"   # Finder 에서 띄우면 PATH 가 짧다 (docker, npm, adb)
if [ ! -x "$ROOT/venv/bin/python" ]; then
  osascript -e 'display alert "nrtrail" message "가상환경(venv)이 없습니다. README 의 설치 명령을 먼저 실행하세요."'
  exit 1
fi
mkdir -p "$ROOT/sessions"
exec "$ROOT/venv/bin/python" "$ROOT/tools/app.py" >> "$ROOT/sessions/launcher-stdout.log" 2>&1
